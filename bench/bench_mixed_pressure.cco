// bench_mixed_pressure.cco - Mixed integer & float high register pressure
fn mixed_kernel(seed: int, fseed: float) -> int {
    let i0: int = seed + 1;
    let i1: int = seed + 2;
    let i2: int = seed + 3;
    let i3: int = seed + 4;
    let i4: int = seed + 5;
    let i5: int = seed + 6;
    let i6: int = seed + 7;
    let i7: int = seed + 8;

    let f0: float = fseed + 0.5;
    let f1: float = fseed + 1.5;
    let f2: float = fseed + 2.5;
    let f3: float = fseed + 3.5;
    let f4: float = fseed + 4.5;
    let f5: float = fseed + 5.5;
    let f6: float = fseed + 6.5;
    let f7: float = fseed + 7.5;

    // Cross combinations keeping all 16 values alive
    let isum: int = (i0 * 3) - (i1 * 2) + (i2 * 5) - (i3 * 4) + (i4 * 7) - (i5 * 6) + (i6 * 9) - (i7 * 8);
    let fsum: float = (f0 * 1.1) + (f1 * 2.2) - (f2 * 3.3) + (f3 * 4.4) - (f4 * 5.5) + (f5 * 6.6) - (f6 * 7.7) + (f7 * 8.8);

    let icomb: int = isum + (i0 + i7) * (i2 + i5) - (i1 + i6) * (i3 + i4);
    let fcomb: float = fsum + (f0 + f7) * (f2 + f5) - (f1 + f6) * (f3 + f4);

    if (fcomb > 0.0) {
        return (icomb + 1) % 100000;
    } else {
        return (icomb - 1) % 100000;
    }
}

fn main() -> int {
    let total: int = 0;
    let n: int = 0;
    while (n < 400000) {
        total = (total + mixed_kernel(n % 50, 1.25)) % 10000000;
        n = n + 1;
    }
    print(total);
    return 0;
}
