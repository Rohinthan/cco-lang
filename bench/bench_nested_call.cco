// bench_nested_call.cco - Deep nested calls testing inlining and call overhead
fn leaf_add(x: int, y: int) -> int {
    return x + y + 3;
}

fn level3(a: int, b: int) -> int {
    let p: int = leaf_add(a, b);
    let q: int = leaf_add(b, a * 2);
    return p * 2 + q;
}

fn level2(m: int, n: int) -> int {
    let r1: int = level3(m, n);
    let r2: int = level3(n, m + 1);
    return (r1 + r2) % 10000;
}

fn level1(u: int, v: int) -> int {
    let s1: int = level2(u, v);
    let s2: int = level2(v, u + 2);
    return s1 + s2;
}

fn main() -> int {
    let acc: int = 0;
    let i: int = 0;
    while (i < 300000) {
        acc = (acc + level1(i % 50, (i + 1) % 50)) % 10000000;
        i = i + 1;
    }
    print(acc);
    return 0;
}
