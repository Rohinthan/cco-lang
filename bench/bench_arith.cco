// bench_arith.cco - Arithmetic throughput and expression optimization
fn calc_arith(iterations: int) -> int {
    let acc: int = 0;
    let i: int = 0;
    while (i < iterations) {
        // Redundant expressions for GVN/CSE
        let a: int = (i * 3) + 7;
        let b: int = (i * 3) + 7;
        let c: int = (a + b) % 1000;
        
        // Constant folding opportunities
        let folded: int = (12 * 8) + (100 / 4) - 21; // 96 + 25 - 21 = 100
        
        acc = (acc + c + folded) % 10000000;
        i = i + 1;
    }
    return acc;
}

fn main() -> int {
    let res: int = calc_arith(2000000);
    print(res);
    return 0;
}
