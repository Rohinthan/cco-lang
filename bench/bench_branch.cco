// bench_branch.cco - Conditional branching, SCCP branch folding, and nested control flow
fn branch_eval(iterations: int) -> int {
    let sum: int = 0;
    let i: int = 0;
    while (i < iterations) {
        // SCCP-prunable branch (constant condition)
        let static_val: int = 0;
        if (10 > 5) {
            static_val = 100;
        } else {
            static_val = 200;
        }

        // Runtime data-dependent branch
        let rem: int = i % 4;
        if (rem == 0) {
            sum = sum + static_val + 1;
        } else {
            if (rem == 1) {
                sum = sum + static_val + 2;
            } else {
                if (rem == 2) {
                    sum = sum + static_val + 3;
                } else {
                    sum = sum + static_val + 4;
                }
            }
        }
        sum = sum % 10000000;
        i = i + 1;
    }
    return sum;
}

fn main() -> int {
    let res: int = branch_eval(2000000);
    print(res);
    return 0;
}
