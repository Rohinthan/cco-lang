// bench_regpressure.cco - High register pressure and live interval interference
fn compute_pressure(base: int) -> int {
    let a: int = base + 1;
    let b: int = base + 2;
    let c: int = base + 3;
    let d: int = base + 4;
    let e: int = base + 5;
    let f: int = base + 6;
    let g: int = base + 7;
    let h: int = base + 8;
    let i: int = base + 9;
    let j: int = base + 10;
    let k: int = base + 11;
    let l: int = base + 12;

    let sum1: int = (a * 2) + (b * 3) - (c * 4) + (d * 5);
    let sum2: int = (e * 2) - (f * 3) + (g * 4) - (h * 5);
    let sum3: int = (i * 2) + (j * 3) - (k * 4) + (l * 5);

    // Reuse and cross-combine variables while keeping earlier values live
    let mixed: int = (a + sum1) * (b + sum2) - (c + sum3);
    let combined: int = mixed + (d * e) - (f * g) + (h * i) - (j * k) + l;

    return combined % 100000;
}

fn main() -> int {
    let total: int = 0;
    let n: int = 0;
    while (n < 500000) {
        total = (total + compute_pressure(n % 100)) % 10000000;
        n = n + 1;
    }
    print(total);
    return 0;
}
