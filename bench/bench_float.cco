// bench_float.cco - Numerical integration floating-point throughput
fn estimate_pi(steps: float, n_iterations: int) -> float {
    let step_size: float = 1.0 / steps;
    let sum: float = 0.0;
    let x: float = 0.5 * step_size;
    let i: int = 0;
    while (i < n_iterations) {
        sum = sum + 4.0 / (1.0 + x * x);
        x = x + step_size;
        i = i + 1;
    }
    return sum * step_size;
}

fn main() -> int {
    let pi: float = estimate_pi(5000000.0, 5000000);
    let pass: bool = (pi > 3.1415) && (pi < 3.1416);
    if (pass) {
        print(1);
    } else {
        print(0);
    }
    return 0;
}
