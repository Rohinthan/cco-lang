// bench_loop.cco - Nested loops and loop-invariant arithmetic (LICM)
fn test_loop(outer: int, inner: int) -> int {
    let total: int = 0;
    let i: int = 0;
    let base: int = 42;
    let mult: int = 17;
    while (i < outer) {
        let j: int = 0;
        while (j < inner) {
            // Loop-invariant expression inside inner loop
            let inv: int = (base * mult) + 5;
            total = (total + inv + j) % 10000000;
            j = j + 1;
        }
        i = i + 1;
    }
    return total;
}

fn main() -> int {
    let res: int = test_loop(5000, 2000);
    print(res);
    return 0;
}
