// 09_object_array_todo.cco — Demonstrates Growable Arrays of Objects and for-each iteration in Cco v9.0

class Task {
    id: int;
    title: string;
    completed: bool;

    fn print_task(self) -> void {
        if (self.completed) {
            print("[X]");
        } else {
            print("[ ]");
        }
        print(self.title);
    }
}

fn main() -> int {
    let tasks: Task[] = list_new(Task);

    tasks = push(tasks, Task { id: 1, title: "Build Cco v9.0 growable arrays", completed: true });
    tasks = push(tasks, Task { id: 2, title: "Add list_new, push, pop, len", completed: true });
    tasks = push(tasks, Task { id: 3, title: "Write awesome example gallery", completed: false });

    print("--- TODO LIST ---");
    print(len(tasks));

    for task in tasks {
        task.print_task();
    }

    return 0;
}
