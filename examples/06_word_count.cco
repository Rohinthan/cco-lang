// 06_word_count.cco — Reading a text file and counting words

fn is_space(c: char) -> bool {
    return c == ' ' || c == '\n' || c == '\t' || c == '\r';
}

fn count_words(text: string) -> int {
    let count: int = 0;
    let in_word: bool = false;
    let length: int = len(text);

    for (let i: int = 0; i < length; i = i + 1) {
        let ch: char = char_at(text, i);
        if (is_space(ch)) {
            in_word = false;
        } else {
            if (!in_word) {
                count = count + 1;
                in_word = true;
            }
        }
    }
    return count;
}

fn main() -> int {
    let filename: string = "examples/sample_data/word_count_input.txt";
    let content: string = read_file(filename);

    print(len(content));
    print(count_words(content));

    return 0;
}
