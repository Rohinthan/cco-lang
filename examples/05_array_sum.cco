// 05_array_sum.cco — Dynamic array allocation and iteration in top-level script style

let size: int = 5;
let numbers: int = alloc(int, size);

for (let i: int = 0; i < size; i++) {
    numbers[i] = (i + 1) * 10;
}

let sum: int = 0;
for (let i: int = 0; i < size; i++) {
    sum += numbers[i];
}

print(sum);
