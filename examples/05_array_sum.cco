// 05_array_sum.cco — Dynamic array allocation and iteration

fn main() -> int {
    let size: int = 5;
    let numbers: int = alloc(int, size);

    for (let i: int = 0; i < size; i = i + 1) {
        numbers[i] = (i + 1) * 10;
    }

    let sum: int = 0;
    for (let i: int = 0; i < size; i = i + 1) {
        sum = sum + numbers[i];
    }

    print(sum);
    return 0;
}
