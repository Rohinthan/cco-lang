// 05_array_sum.cco — Dynamic array allocation and iteration with v19 sugar

fn main() -> int {
    let size = 5;
    let numbers = alloc(int, size);

    for (let i = 0; i < size; i++) {
        numbers[i] = (i + 1) * 10;
    }

    let sum = 0;
    for (let i = 0; i < size; i++) {
        sum += numbers[i];
    }

    print(sum);
    return 0;
}
