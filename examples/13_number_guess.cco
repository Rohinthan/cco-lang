// Interactive Number Guessing Game in Cco v19
// Demonstrates f-strings, random_seed(), random_int(), read_line(), is_int(), to_int(), and type inference

fn play_round(secret: int, guess_str: string) -> bool {
    if (is_int(guess_str)) {
        let guess = to_int(guess_str);
        if (guess == secret) {
            print(f"Correct! You guessed the secret number: {secret}.");
            return true;
        } else {
            if (guess < secret) {
                print(f"Guess {guess} is too low!");
            } else {
                print(f"Guess {guess} is too high!");
            }
            return false;
        }
    } else {
        print(f"Invalid input '{guess_str}': not an integer.");
        return false;
    }
}

fn main() -> int {
    random_seed(12345);
    let secret = random_int(1, 50);

    print("Secret number chosen between 1 and 50.");
    print("Testing simulated guesses:");

    let g1 = "10";
    let w1 = play_round(secret, g1);
    if (!w1) {
        let g2 = "invalid_guess";
        let w2 = play_round(secret, g2);
        if (!w2) {
            let g3 = "40";
            play_round(secret, g3);
        }
    }

    print("Game completed successfully.");
    return 0;
}
