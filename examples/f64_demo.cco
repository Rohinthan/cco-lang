fn compute_area(radius: float) -> float {
    let pi: float = 3.1416;
    return pi * radius * radius;
}

fn scale_down(val: float, factor: float) -> float {
    return val / factor;
}

fn main() -> int {
    let r: float = 2.5;
    let area: float = compute_area(r);
    print(area);

    let scaled: float = scale_down(area, 2.0);
    print(scaled);

    let count: float = 0.0;
    while (count < 3.0) {
        count = count + 1.0;
    }
    print(count);

    if (scaled > 5.0) {
        print(1);
    } else {
        print(0);
    }

    return 0;
}
