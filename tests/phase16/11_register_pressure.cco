fn main() -> int {
    let v1: int = 1;
    let v2: int = 2;
    let v3: int = 3;
    let v4: int = 4;
    let v5: int = 5;
    let v6: int = 6;
    let v7: int = 7;
    let v8: int = 8;
    let res: int = (v1 + v2) * (v3 + v4) + (v5 + v6) * (v7 + v8);
    // (3 * 7) + (11 * 15) = 21 + 165 = 186
    return res;
}
