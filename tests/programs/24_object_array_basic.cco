class Point {
    x: int;
    y: int;

    fn sum(self) -> int {
        return self.x + self.y;
    }
}

fn main() -> int {
    let pts: Point[] = alloc(Point, 3);
    pts[0] = Point { x: 10, y: 20 };
    pts[1] = Point { x: 30, y: 40 };

    print(pts[0].x);
    print(pts[0].y);
    print(pts[1].sum());
    return 0;
}
