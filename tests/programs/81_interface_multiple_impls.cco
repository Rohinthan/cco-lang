interface Describable {
    fn describe(self) -> void;
}

class Point {
    x: int;
    y: int;

    fn describe(self) -> void {
        print(f"Point({self.x}, {self.y})");
    }
}

class Circle {
    radius: int;

    fn describe(self) -> void {
        print(f"Circle(r={self.radius})");
    }
}

impl Describable for Point;
impl Describable for Circle;

fn announce(item: impl Describable) -> void {
    item.describe();
}

fn main() -> int {
    let p: Point = Point { x: 5, y: 15 };
    let c: Circle = Circle { radius: 42 };
    announce(p);
    announce(c);
    return 0;
}
