struct Vec2 {
    x: float;
    y: float;
}

fn operator+(a: Vec2, b: Vec2) -> Vec2 {
    return Vec2 { x: a.x + b.x, y: a.y + b.y };
}

fn main() -> int {
    let p: Vec2 = Vec2 { x: 1.0, y: 2.0 };
    let q: Vec2 = Vec2 { x: 3.0, y: 4.0 };
    let r: Vec2 = p + q;
    print(r.x);
    print(r.y);
    return 0;
}
