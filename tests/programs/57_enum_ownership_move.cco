enum Message {
    Quit,
    Text { content: string },
    Move { dx: int, dy: int },
}

fn process_message(m: Message) -> void {
    match m {
        Message.Quit => {
            print("quitting");
        }
        Message.Text { content } => {
            print(content);
        }
        Message.Move { dx, dy } => {
            print(dx + dy);
        }
    }
}

fn create_message() -> Message {
    return Message.Text { content: "hello from function" };
}

fn main() -> void {
    let m1: Message = Message.Move { dx: 10, dy: 20 };
    let m2: Message = m1; // move m1 into m2
    process_message(m2);

    let m3: Message = create_message(); // move from return
    process_message(m3);

    let m4: Message = Message.Quit;
    process_message(m4);
}
