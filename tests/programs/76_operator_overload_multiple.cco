struct Vec2 {
    x: float;
    y: float;
}

fn operator+(a: Vec2, b: Vec2) -> Vec2 {
    return Vec2 { x: a.x + b.x, y: a.y + b.y };
}

fn operator-(a: Vec2, b: Vec2) -> Vec2 {
    return Vec2 { x: a.x - b.x, y: a.y - b.y };
}

fn operator*(a: Vec2, b: Vec2) -> Vec2 {
    return Vec2 { x: a.x * b.x, y: a.y * b.y };
}

fn operator==(a: Vec2, b: Vec2) -> bool {
    return a.x == b.x && a.y == b.y;
}

fn operator!=(a: Vec2, b: Vec2) -> bool {
    return a.x != b.x || a.y != b.y;
}

fn main() -> int {
    let p: Vec2 = Vec2 { x: 10.0, y: 20.0 };
    let q: Vec2 = Vec2 { x: 2.0, y: 5.0 };
    let sum: Vec2 = p + q;
    let diff: Vec2 = p - q;
    let prod: Vec2 = p * q;

    print(sum.x);
    print(sum.y);
    print(diff.x);
    print(diff.y);
    print(prod.x);
    print(prod.y);
    print(p == p);
    print(p == q);
    print(p != q);
    return 0;
}
