interface Printable {
    fn describe(self) -> void;
}

class Point {
    x: int;
    y: int;

    fn describe(self) -> void {
        print(f"Point({self.x}, {self.y})");
    }
}

class Circle {
    radius: int;

    fn describe(self) -> void {
        print(f"Circle({self.radius})");
    }
}

impl Printable for Point;
// Note: Circle has matching method describe(), but lacks `impl Printable for Circle;`

fn announce(item: impl Printable) -> void {
    item.describe();
}

fn main() -> int {
    let c: Circle = Circle { radius: 10 };
    announce(c);
    return 0;
}
