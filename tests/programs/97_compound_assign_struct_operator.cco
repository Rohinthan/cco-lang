struct Vec2 {
    x: int;
    y: int;
}

fn operator+(a: Vec2, b: Vec2) -> Vec2 {
    return Vec2 { x: a.x + b.x, y: a.y + b.y };
}

fn main() -> int {
    let v = Vec2 { x: 10, y: 20 };
    let delta = Vec2 { x: 5, y: -3 };
    v += delta;
    print(v.x);
    print(v.y);

    v += Vec2 { x: 1, y: 1 };
    print(v.x);
    print(v.y);

    return 0;
}
