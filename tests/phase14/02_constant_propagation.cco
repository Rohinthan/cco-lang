// Phase 14 Test 02: Constant Propagation
fn main() -> int {
    let x: int = 10;
    let y: int = x;
    let z: int = y + 5;
    let w: int = z * 2;
    print(x);
    print(y);
    print(z);
    print(w);

    let flag: bool = true;
    let flag_copy: bool = flag;
    if (flag_copy) {
        print(100);
    } else {
        print(200);
    }

    let p: int = 50;
    p = 60;
    let q: int = p + 10;
    print(p);
    print(q);

    return 0;
}
