// Phase 14 Test 08: Loop Preservation
fn main() -> int {
    let sum: int = 0;
    let i: int = 0;
    while (i < 5) {
        sum = sum + i;
        i = i + 1;
    }
    print(sum);

    let for_sum: int = 0;
    for (let j: int = 0; j < 5; j++) {
        for_sum = for_sum + j;
    }
    print(for_sum);

    return 0;
}
