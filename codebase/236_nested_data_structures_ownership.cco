// Test 3: Nested Data Structures & Map/Array Ownership Transfer

class Item {
    sku: string;
    price: float;
}

class Inventory {
    categories: map[string]Item[];
}

fn main() -> int {
    print("==========================================================");
    print("  TEST 3: NESTED DATA STRUCTURES & MAP/ARRAY OWNERSHIP    ");
    print("==========================================================");

    let inv: Inventory = Inventory { categories: map_new(string, Item[]) };
    
    let c: int = 0;
    while (c < 10) {
        let cat_name: string = f"Category_{c}";
        let items: Item[] = alloc(Item, 0);
        
        let j: int = 0;
        while (j < 5) {
            let price_str: string = f"{j}.99";
            let item: Item = Item { sku: f"SKU_{c}_{j}", price: to_float(price_str) };
            items = push(items, item);
            j = j + 1;
        }
        
        // Transfer array ownership into map
        inv.categories = put(inv.categories, cat_name, items);
        c = c + 1;
    }

    // Inspect keys and iterate over nested arrays
    let cat_keys: string[] = keys(inv.categories);
    let found_count: int = 0;
    for key in cat_keys {
        let list: Item[] = get(inv.categories, key);
        for it in list {
            if (equals(it.sku, "SKU_2_3")) {
                print(f"Found targeted item: {it.sku} @ {it.price}");
                found_count += 1;
            }
        }
    }

    print(f"Total targeted items found: {found_count}");
    print("Nested Map[string]Item[] test completed successfully!");
    return 0;
}
