class ValueBox {
    val: int;
}

class ValueHandle {
    target: ValueBox;
}

fn main() -> int {
    let handle: ValueHandle = ValueHandle {
        target: ValueBox { val: 10 }
    };

    print("=== Multi-Level Reference Indirection ===");
    print(f"Value through handle: {handle.target.val}");

    return 0;
}
