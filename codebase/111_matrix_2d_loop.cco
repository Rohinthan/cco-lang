fn main() -> int {
    let row0: int[] = alloc(int, 3);
    row0[0] = 1;
    row0[1] = 4;
    row0[2] = 2;

    let row1: int[] = alloc(int, 3);
    row1[0] = 3;
    row1[1] = 6;
    row1[2] = 8;

    print("=== Looping Through 2D Matrix Rows ===");
    for val in row0 {
        print(val);
    }
    for val in row1 {
        print(val);
    }

    return 0;
}
