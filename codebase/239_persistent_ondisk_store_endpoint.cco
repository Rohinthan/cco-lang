fn main() -> int {
    let server_fd: int = net_listen(8081);
    print("Storage API listening on http://localhost:8081 ...");

    // Initialize initial database log file
    write_file("storage.log", "--- CCO STORAGE DB STARTED ---\n");

    let count: int = 0;
    while (count < 5) {
        let client_fd: int = net_accept(server_fd);
        if (client_fd >= 0) {
            let req: string = net_recv(client_fd, 2048);

            let log_entry: string = f"Request #{count} processed successfully.\n";
            write_file("storage.log", log_entry);

            let stored_data: string = read_file("storage.log");
            let http_header: string = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nConnection: close\r\n\r\n";
            let full_response: string = concat(http_header, stored_data);

            net_send(client_fd, full_response);
            net_close(client_fd);
            
            count = count + 1;
        }
    }

    net_close(server_fd);
    return 0;
}
