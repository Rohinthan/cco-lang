fn main() -> int {
    let str1 = "Hello ";
    let str2 = "World!";

    // Method 1: Using built-in concat()
    let combined = concat(str1, str2);
    print(f"concat(str1, str2): {combined}");

    // Method 2: Using compound += assignment
    let greeting = "Hello ";
    greeting += "World!";
    print(f"greeting += 'World!': {greeting}");

    return 0;
}
