// Test 1: Scope Exit & Control-Flow Leak Gauntlet

class Resource {
    id: int;
    tag: string;
}

fn process_resource(r: &Resource, mode: int) -> string {
    let name: string = f"Res_{r.id}_{r.tag}";
    
    if (mode == 0) {
        // Early return must release `name` without double-freeing borrowed `r`
        let ret: string = concat(name, "_EARLY_EXIT");
        return ret;
    }

    let i: int = 0;
    while (i < 5) {
        i = i + 1;
        let temp: string = f"Loop_{i}_{name}";
        
        if (i == 2) {
            // Must clean up `temp` before continue
            continue;
        }
        if (i == 4) {
            // Must clean up `temp` and break while loop correctly
            break;
        }
        print(temp);
    }

    let final_res: string = concat(name, "_DONE");
    return final_res;
}

fn main() -> int {
    print("==========================================================");
    print("  TEST 1: SCOPE EXIT & CONTROL-FLOW LEAK GAUNTLET         ");
    print("==========================================================");

    let r: Resource = Resource { id: 101, tag: "CRITICAL" };
    let i: int = 0;
    while (i < 100) {
        let res1: string = process_resource(&r, 0);
        let res2: string = process_resource(&r, 1);
        i = i + 1;
    }

    print("\n100 iterations of nested break/continue/early-return executed!");
    print("Gauntlet completed with 0 memory leaks!");
    return 0;
}
