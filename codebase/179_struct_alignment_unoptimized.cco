struct UnoptimizedData {
    a: char;
    b: int;
    c: char;
}

fn main() -> int {
    let data: UnoptimizedData = UnoptimizedData {
        a: 'X',
        b: 42,
        c: 'Y'
    };

    print("=== Unoptimized Field Alignment Struct ===");
    print(f"a: {data.a}");
    print(f"b: {data.b}");
    print(f"c: {data.c}");

    return 0;
}
