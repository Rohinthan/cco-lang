fn main() -> int {
    let my_int = 42;
    let my_float = 3.14159;
    let my_char = 'Z';
    let my_bool = true;

    print("=== Primitive Memory Values ===");
    print(f"Integer value: {my_int}");
    print(f"Float value: {my_float}");
    print(f"Char value: {my_char}");
    print(f"Bool value: {my_bool}");

    return 0;
}
