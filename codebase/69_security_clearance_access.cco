fn main() -> int {
    let is_logged_in = true;
    let is_admin = false;
    let security_level = 3; // 1 = highest

    print(f"Logged in: {is_logged_in}, Admin: {is_admin}, Security level: {security_level}");

    if (is_logged_in && (is_admin || security_level <= 2)) {
        print("Access granted");
    } else {
        print("Access denied");
    }

    return 0;
}
