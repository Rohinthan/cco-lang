// Algorithm 1: Linear Regression & Regularization Variants (OLS, Ridge/L2, Lasso/L1, ElasticNet)

struct RegressionModel {
    slope: float;
    intercept: float;
    mse: float;
    r2_score: float;
}

fn sign_f(v: float) -> float {
    if (v > 0.0) {
        return 1.0;
    } else if (v < 0.0) {
        return -1.0;
    }
    return 0.0;
}

// 1. Ordinary Least Squares (OLS) - Analytical Closed-Form Solution
fn train_ols(x: &float[], y: &float[], n: int) -> RegressionModel {
    let sum_x: float = 0.0;
    let sum_y: float = 0.0;
    for (let i = 0; i < n; i++) {
        sum_x += x[i];
        sum_y += y[i];
    }
    let n_f: float = 1.0 * n;
    let mean_x: float = sum_x / n_f;
    let mean_y: float = sum_y / n_f;

    let numerator: float = 0.0;
    let denominator: float = 0.0;
    for (let i = 0; i < n; i++) {
        let diff_x: float = x[i] - mean_x;
        let diff_y: float = y[i] - mean_y;
        numerator += diff_x * diff_y;
        denominator += diff_x * diff_x;
    }

    let slope: float = 0.0;
    if (denominator != 0.0) {
        slope = numerator / denominator;
    }
    let intercept: float = mean_y - slope * mean_x;

    // Calculate MSE and R^2
    let ss_res: float = 0.0;
    let ss_tot: float = 0.0;
    for (let i = 0; i < n; i++) {
        let y_pred: float = slope * x[i] + intercept;
        let err: float = y[i] - y_pred;
        ss_res += err * err;
        let diff_mean: float = y[i] - mean_y;
        ss_tot += diff_mean * diff_mean;
    }

    let mse: float = ss_res / n_f;
    let r2: float = 1.0 - (ss_res / ss_tot);

    return RegressionModel { slope: slope, intercept: intercept, mse: mse, r2_score: r2 };
}

// 2. Ridge Regression (L2 Penalty) - Gradient Descent with Weight Decay
fn train_ridge(x: &float[], y: &float[], n: int, l2_lambda: float, lr: float, epochs: int) -> RegressionModel {
    let w: float = 0.0;
    let b: float = 0.0;
    let n_f: float = 1.0 * n;

    for (let ep = 0; ep < epochs; ep++) {
        let grad_w: float = 0.0;
        let grad_b: float = 0.0;

        for (let i = 0; i < n; i++) {
            let y_pred: float = w * x[i] + b;
            let err: float = y_pred - y[i];
            grad_w += err * x[i];
            grad_b += err;
        }

        // L2 Penalty gradient: lambda * w
        grad_w = (grad_w / n_f) + l2_lambda * w;
        grad_b = grad_b / n_f;

        w -= lr * grad_w;
        b -= lr * grad_b;
    }

    // Evaluation
    let sum_y: float = 0.0;
    for (let i = 0; i < n; i++) { sum_y += y[i]; }
    let mean_y: float = sum_y / n_f;

    let ss_res: float = 0.0;
    let ss_tot: float = 0.0;
    for (let i = 0; i < n; i++) {
        let y_pred: float = w * x[i] + b;
        let err: float = y[i] - y_pred;
        ss_res += err * err;
        let diff_mean: float = y[i] - mean_y;
        ss_tot += diff_mean * diff_mean;
    }

    let mse: float = ss_res / n_f;
    let r2: float = 1.0 - (ss_res / ss_tot);

    return RegressionModel { slope: w, intercept: b, mse: mse, r2_score: r2 };
}

// 3. Lasso Regression (L1 Penalty) - Subgradient Descent for Sparse Weights
fn train_lasso(x: &float[], y: &float[], n: int, l1_lambda: float, lr: float, epochs: int) -> RegressionModel {
    let w: float = 0.0;
    let b: float = 0.0;
    let n_f: float = 1.0 * n;

    for (let ep = 0; ep < epochs; ep++) {
        let grad_w: float = 0.0;
        let grad_b: float = 0.0;

        for (let i = 0; i < n; i++) {
            let y_pred: float = w * x[i] + b;
            let err: float = y_pred - y[i];
            grad_w += err * x[i];
            grad_b += err;
        }

        // L1 Penalty subgradient: lambda * sign(w)
        grad_w = (grad_w / n_f) + l1_lambda * sign_f(w);
        grad_b = grad_b / n_f;

        w -= lr * grad_w;
        b -= lr * grad_b;
    }

    // Evaluation
    let sum_y: float = 0.0;
    for (let i = 0; i < n; i++) { sum_y += y[i]; }
    let mean_y: float = sum_y / n_f;

    let ss_res: float = 0.0;
    let ss_tot: float = 0.0;
    for (let i = 0; i < n; i++) {
        let y_pred: float = w * x[i] + b;
        let err: float = y[i] - y_pred;
        ss_res += err * err;
        let diff_mean: float = y[i] - mean_y;
        ss_tot += diff_mean * diff_mean;
    }

    let mse: float = ss_res / n_f;
    let r2: float = 1.0 - (ss_res / ss_tot);

    return RegressionModel { slope: w, intercept: b, mse: mse, r2_score: r2 };
}

// 4. ElasticNet Regression (L1 + L2 Mixed Regularization)
fn train_elastic_net(x: &float[], y: &float[], n: int, l1_lambda: float, l2_lambda: float, lr: float, epochs: int) -> RegressionModel {
    let w: float = 0.0;
    let b: float = 0.0;
    let n_f: float = 1.0 * n;

    for (let ep = 0; ep < epochs; ep++) {
        let grad_w: float = 0.0;
        let grad_b: float = 0.0;

        for (let i = 0; i < n; i++) {
            let y_pred: float = w * x[i] + b;
            let err: float = y_pred - y[i];
            grad_w += err * x[i];
            grad_b += err;
        }

        // Combined L1 and L2 penalty gradient
        grad_w = (grad_w / n_f) + l1_lambda * sign_f(w) + l2_lambda * w;
        grad_b = grad_b / n_f;

        w -= lr * grad_w;
        b -= lr * grad_b;
    }

    // Evaluation
    let sum_y: float = 0.0;
    for (let i = 0; i < n; i++) { sum_y += y[i]; }
    let mean_y: float = sum_y / n_f;

    let ss_res: float = 0.0;
    let ss_tot: float = 0.0;
    for (let i = 0; i < n; i++) {
        let y_pred: float = w * x[i] + b;
        let err: float = y[i] - y_pred;
        ss_res += err * err;
        let diff_mean: float = y[i] - mean_y;
        ss_tot += diff_mean * diff_mean;
    }

    let mse: float = ss_res / n_f;
    let r2: float = 1.0 - (ss_res / ss_tot);

    return RegressionModel { slope: w, intercept: b, mse: mse, r2_score: r2 };
}

fn predict(m: &RegressionModel, x_val: float) -> float {
    return m.slope * x_val + m.intercept;
}

fn print_model_summary(name: string, m: &RegressionModel) -> void {
    print(f"=== {name} Model ===");
    print(f"  Fitted Equation : y = {m.slope} * x + {m.intercept}");
    print(f"  Mean Squared Error (MSE) : {m.mse}");
    print(f"  R^2 Score       : {m.r2_score}");
}

fn main() -> int {
    print("==========================================================");
    print("   LINEAR REGRESSION & REGULARIZATION SUITE (Cco-v20)     ");
    print("==========================================================\n");

    // Synthetic linear dataset with slight noise: y ~= 2.5 * x + 1.2
    let n: int = 6;
    let x: float[] = alloc(float, n);
    let y: float[] = alloc(float, n);

    x[0] = 1.0; y[0] = 3.6;
    x[1] = 2.0; y[1] = 6.3;
    x[2] = 3.0; y[2] = 8.7;
    x[3] = 4.0; y[3] = 11.2;
    x[4] = 5.0; y[4] = 13.8;
    x[5] = 6.0; y[5] = 16.1;

    print(f"Training on {n} data points...\n");

    // 1. OLS
    let ols_model: RegressionModel = train_ols(&x, &y, n);
    print_model_summary("Ordinary Least Squares (OLS)", &ols_model);
    let pred_ols_7: float = predict(&ols_model, 7.0);
    print(f"  Prediction for x=7.0 -> y={pred_ols_7}\n");

    // 2. Ridge (L2)
    let ridge_model: RegressionModel = train_ridge(&x, &y, n, 0.05, 0.01, 2000);
    print_model_summary("Ridge Regression (L2 Regularized)", &ridge_model);
    let pred_ridge_7: float = predict(&ridge_model, 7.0);
    print(f"  Prediction for x=7.0 -> y={pred_ridge_7}\n");

    // 3. Lasso (L1)
    let lasso_model: RegressionModel = train_lasso(&x, &y, n, 0.02, 0.01, 2000);
    print_model_summary("Lasso Regression (L1 Regularized)", &lasso_model);
    let pred_lasso_7: float = predict(&lasso_model, 7.0);
    print(f"  Prediction for x=7.0 -> y={pred_lasso_7}\n");

    // 4. ElasticNet (L1 + L2)
    let en_model: RegressionModel = train_elastic_net(&x, &y, n, 0.01, 0.03, 0.01, 2000);
    print_model_summary("ElasticNet Regression (L1 + L2 Regularized)", &en_model);
    let pred_en_7: float = predict(&en_model, 7.0);
    print(f"  Prediction for x=7.0 -> y={pred_en_7}\n");

    print("==========================================================");
    print("Linear Regression validation complete with 0 memory leaks!");
    return 0;
}
