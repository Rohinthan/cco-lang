class Owner {
    first_name: string;
    last_name: string;
}

class Car {
    brand: string;
    year: int;
    owner: Owner;
}

fn main() -> int {
    let car1: Car = Car {
        brand: "Toyota",
        year: 2010,
        owner: Owner {
            first_name: "John",
            last_name: "Doe"
        }
    };

    print("=== Nested Data Structure ===");
    print(f"Car: {car1.brand} ({car1.year})");
    print(f"Owner: {car1.owner.first_name} {car1.owner.last_name}");

    return 0;
}
