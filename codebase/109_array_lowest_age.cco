fn main() -> int {
    let ages: int[] = alloc(int, 8);
    ages[0] = 20;
    ages[1] = 22;
    ages[2] = 18;
    ages[3] = 35;
    ages[4] = 48;
    ages[5] = 26;
    ages[6] = 87;
    ages[7] = 70;

    let lowest_age = ages[0];

    for age in ages {
        if (age < lowest_age) {
            lowest_age = age;
        }
    }

    print(f"The lowest age is: {lowest_age}");
    return 0;
}
