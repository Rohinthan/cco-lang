// Test 4: Pass-By-Value Struct Operator Overloading Chain

struct Vec2 {
    x: int;
    y: int;
}

fn operator+(a: Vec2, b: Vec2) -> Vec2 {
    return Vec2 { x: a.x + b.x, y: a.y + b.y };
}

fn operator-(a: Vec2, b: Vec2) -> Vec2 {
    return Vec2 { x: a.x - b.x, y: a.y - b.y };
}

fn operator*(a: Vec2, b: Vec2) -> Vec2 {
    return Vec2 { x: a.x * b.x, y: a.y * b.y };
}

fn operator==(a: Vec2, b: Vec2) -> bool {
    return a.x == b.x && a.y == b.y;
}

fn main() -> int {
    print("==========================================================");
    print("  TEST 4: STRUCT OPERATOR OVERLOADING CHAIN               ");
    print("==========================================================");

    let v1: Vec2 = Vec2 { x: 10, y: 20 };
    let v2: Vec2 = Vec2 { x: 5, y: 15 };
    let v3: Vec2 = Vec2 { x: 2, y: 3 };

    // Deeply nested chained operator calls: (v1 + v2) * v3 - (v1 - v2)
    let res: Vec2 = (v1 + v2) * v3 - (v1 - v2);

    // Expected: ((15, 35) * (2, 3)) - (5, 5) = (30, 105) - (5, 5) = (25, 100)
    let expected: Vec2 = Vec2 { x: 25, y: 100 };

    print(f"Computed Result: ({res.x}, {res.y})");
    print(f"Expected Result: ({expected.x}, {expected.y})");

    if (res == expected) {
        print("Struct Operator Overloading Test Passed!");
    } else {
        print(f"FAILED: Got ({res.x}, {res.y})");
    }

    return 0;
}
