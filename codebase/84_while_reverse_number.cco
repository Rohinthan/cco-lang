fn main() -> int {
    let numbers = 12345;
    let rev_numbers = 0;

    print(f"Original number: {numbers}");

    while (numbers > 0) {
        // Extract the last digit and append it to reversed number
        rev_numbers = rev_numbers * 10 + (numbers % 10);
        // Remove the last digit
        numbers /= 10;
    }

    print(f"Reversed number: {rev_numbers}");
    return 0;
}
