fn main() -> int {
    let rows = 2;
    let cols = 3;
    let matrix: int[] = alloc(int, rows * cols);

    // Populate matrix (Row 0: 1, 4, 2 | Row 1: 3, 6, 8)
    matrix[0 * cols + 0] = 1;
    matrix[0 * cols + 1] = 4;
    matrix[0 * cols + 2] = 2;

    matrix[1 * cols + 0] = 3;
    matrix[1 * cols + 1] = 6;
    matrix[1 * cols + 2] = 8;

    print("=== 2D Matrix Grid (2 Rows x 3 Columns) ===");
    for (let r = 0; r < rows; r++) {
        let v0 = matrix[r * cols + 0];
        let v1 = matrix[r * cols + 1];
        let v2 = matrix[r * cols + 2];
        print(f"{v0} {v1} {v2}");
    }

    return 0;
}
