fn main() -> int {
    // Allocate dynamic memory for 4 integers
    let ptr: int[] = alloc(int, 4);

    // Write to the memory
    ptr[0] = 2;
    ptr[1] = 4;
    ptr[2] = 6;
    ptr[3] = 8;

    // Read from the memory
    print("=== Accessing Dynamic Memory ===");
    print(f"First element: {ptr[0]}");
    print(f"Remaining elements: {ptr[1]}, {ptr[2]}, {ptr[3]}");

    return 0;
}
