fn main() -> int {
    let my_numbers: int[] = alloc(int, 4);
    my_numbers[0] = 25;
    my_numbers[1] = 50;
    my_numbers[2] = 75;
    my_numbers[3] = 100;

    print("=== Stepping Through Array via Cursor ===");
    let ptr = 0;
    for (let i = 0; i < 4; i++) {
        print(f"Element at cursor: {my_numbers[ptr]}");
        ptr++; // advance cursor
    }

    return 0;
}
