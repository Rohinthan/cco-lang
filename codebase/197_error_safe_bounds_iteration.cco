fn main() -> int {
    let numbers: int[] = alloc(int, 3);
    numbers[0] = 10;
    numbers[1] = 20;
    numbers[2] = 30;

    print("=== Safe Array Traversal ===");
    // In C, accessing numbers[8] reads corrupt garbage from stack/heap.
    // In Cco, 'for in' loop guarantees traversing only valid, in-bounds elements!
    for n in numbers {
        print(n);
    }

    return 0;
}
