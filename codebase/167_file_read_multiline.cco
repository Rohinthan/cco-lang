fn main() -> int {
    let filename = "build/atomic/multiline_test.txt";
    let initial_text = "Hello World!\nHi everybody!\nLine 3 of text.";
    write_file(filename, initial_text);

    print("=== Reading Multiline File ===");
    let contents = read_file(filename);
    print(contents);

    return 0;
}
