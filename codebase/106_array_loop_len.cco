fn main() -> int {
    let my_numbers: int[] = alloc(int, 4);
    my_numbers[0] = 25;
    my_numbers[1] = 50;
    my_numbers[2] = 75;
    my_numbers[3] = 100;

    let length = len(my_numbers);
    print(f"Array length dynamically determined: {length}");

    print("=== Iterating with len() ===");
    for (let i = 0; i < length; i++) {
        print(my_numbers[i]);
    }

    return 0;
}
