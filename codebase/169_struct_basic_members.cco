struct MyStructure {
    my_num: int;
    my_letter: char;
}

fn main() -> int {
    let s1: MyStructure = MyStructure {
        my_num: 13,
        my_letter: 'B'
    };

    print("=== Accessing Struct Members ===");
    print(f"My number: {s1.my_num}");
    print(f"My letter: {s1.my_letter}");

    // Modify members
    s1.my_num = 30;
    s1.my_letter = 'C';

    print("\n=== Modified Struct Members ===");
    print(f"My number: {s1.my_num}");
    print(f"My letter: {s1.my_letter}");

    return 0;
}
