fn print_numbers(numbers: int[]) -> void {
    for n in numbers {
        print(n);
    }
}

fn main() -> int {
    let my_numbers: int[] = alloc(int, 5);
    my_numbers[0] = 10;
    my_numbers[1] = 20;
    my_numbers[2] = 30;
    my_numbers[3] = 40;
    my_numbers[4] = 50;

    print("=== Passing Array to Function ===");
    print_numbers(my_numbers);
    return 0;
}
