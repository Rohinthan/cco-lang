// std/string.cco — Standard Library String Utilities

fn string_concat(a: string, b: string) -> string {
    return concat(a, b);
}

fn string_sub(s: string, start: int, end: int) -> string {
    return substring(s, start, end);
}

fn string_char_at(s: string, i: int) -> char {
    return char_at(s, i);
}

fn to_str_int(n: int) -> string {
    return to_string(n);
}

fn to_str_bool(b: bool) -> string {
    if (b) { return "true"; }
    return "false";
}

fn to_str_char(c: char) -> string {
    return char_to_string(c);
}

fn parse_int(s: string) -> int {
    return to_int(s);
}

fn parse_float(s: string) -> float {
    return to_float(s);
}

fn is_valid_int(s: string) -> bool {
    return is_int(s);
}

fn is_valid_float(s: string) -> bool {
    return is_float(s);
}

fn char_to_str(c: char) -> string {
    return char_to_string(c);
}

fn int_to_str(n: int) -> string {
    return to_string(n);
}

class StringBuilder {
    chunks: string[];
    count: int;

    fn append(self, s: string) -> void {
        self.chunks = push(self.chunks, concat(s, ""));
        self.count += 1;
    }

    fn to_string(self) -> string {
        let res: string = "";
        for (let i: int = 0; i < self.count; i++) {
            res = concat(res, self.chunks[i]);
        }
        return res;
    }
}

fn sb_new() -> StringBuilder {
    return StringBuilder {
        chunks: list_new(string),
        count: 0,
    };
}
