    };
}

fn make_index_expr(arr: Expr, idx: Expr, line: int, col: int) -> Expr {
    let ch = list_new(Expr);
    ch = push(ch, arr);
    ch = push(ch, idx);
    return Expr {
        kind: 11, // EXPR_INDEX
        int_val: 0,
        float_val: 0.0,
        str_val: concat("", ""),
        bool_val: false,
        char_val: ' ',
        op: concat("", ""),
        callee: concat("", ""),
        type_name: concat("", ""),
        children: ch,
        args: list_new(Expr),
        field_names: list_new(string),
        field_values: list_new(Expr),
        line: line,
        col: col,
    };
}

fn make_new_expr(type_name: string, fnames: string[], fvals: Expr[], line: int, col: int) -> Expr {
    return Expr {
        kind: 12, // EXPR_NEW
        int_val: 0,
        float_val: 0.0,
        str_val: concat("", ""),
        bool_val: false,
        char_val: ' ',
        op: concat("", ""),
        callee: concat(type_name, ""),
        type_name: concat(type_name, ""),
        children: list_new(Expr),
        args: list_new(Expr),
        field_names: fnames,
        field_values: fvals,
        line: line,
        col: col,
    };
}

fn make_alloc_expr(elem_type: string, count_expr: Expr, line: int, col: int) -> Expr {
    let ch = list_new(Expr);
    ch = push(ch, count_expr);
    return Expr {
        kind: 13, // EXPR_ALLOC
        int_val: 0,
        float_val: 0.0,
        str_val: concat("", ""),
        bool_val: false,
        char_val: ' ',
        op: concat("", ""),
        callee: concat(elem_type, ""),
        type_name: concat(elem_type, "[]"),
        children: ch,
        args: list_new(Expr),
        field_names: list_new(string),
        field_values: list_new(Expr),
        line: line,
        col: col,
    };
}

fn make_list_new_expr(elem_type: string, line: int, col: int) -> Expr {
    return Expr {
        kind: 14, // EXPR_LIST_NEW
        int_val: 0,
        float_val: 0.0,
        str_val: concat("", ""),
        bool_val: false,
        char_val: ' ',
        op: concat("", ""),
        callee: concat(elem_type, ""),
        type_name: concat(elem_type, "[]"),
        children: list_new(Expr),
        args: list_new(Expr),
        field_names: list_new(string),
        field_values: list_new(Expr),
        line: line,
        col: col,
    };
}

fn make_map_new_expr(key_type: string, val_type: string, line: int, col: int) -> Expr {
    let map_t = concat("map[", key_type);
    map_t = concat(map_t, "]");
    map_t = concat(map_t, val_type);
    return Expr {
        kind: 15, // EXPR_MAP_NEW
        int_val: 0,
        float_val: 0.0,
        str_val: concat(key_type, ""),
        bool_val: false,
        char_val: ' ',
        op: concat("", ""),
        callee: concat(val_type, ""),
        type_name: map_t,
        children: list_new(Expr),
        args: list_new(Expr),
        field_names: list_new(string),
        field_values: list_new(Expr),
        line: line,
        col: col,
    };
}

fn make_fstring_expr(text: string, line: int, col: int) -> Expr {
    return Expr {
        kind: 16, // EXPR_FSTRING
        int_val: 0,
        float_val: 0.0,
        str_val: concat(text, ""),
        bool_val: false,
        char_val: ' ',
        op: concat("", ""),
        callee: concat("", ""),
        type_name: concat("string", ""),
        children: list_new(Expr),
        args: list_new(Expr),
        field_names: list_new(string),
        field_values: list_new(Expr),
        line: line,
        col: col,
    };
}

// Statement Constructors

fn make_let_stmt(name: string, type_name: string, has_type: bool, init: Expr, line: int, col: int) -> Stmt {
    let inits = list_new(Expr);
    inits = push(inits, init);
    return Stmt {
        kind: 1, // STMT_LET
        var_name: concat(name, ""),
        var_type: concat(type_name, ""),
        has_explicit_type: has_type,
        op: concat("", ""),
        expr: list_new(Expr),
        init_expr: inits,
        cond_expr: list_new(Expr),
        target_expr: list_new(Expr),
        step_stmt: list_new(Stmt),
        then_block: list_new(Stmt),
        else_block: list_new(Stmt),
        body: list_new(Stmt),
        arm_variant: concat("", ""),
        arm_is_wildcard: false,
        arm_bind_vars: list_new(string),
        line: line,
        col: col,
    };
}

fn make_assign_stmt(target: Expr, val: Expr, line: int, col: int) -> Stmt {
    let targets = list_new(Expr);
    targets = push(targets, target);
    let vals = list_new(Expr);
    vals = push(vals, val);
    return Stmt {
        kind: 2, // STMT_ASSIGN
        var_name: concat("", ""),
        var_type: concat("", ""),
        has_explicit_type: false,
        op: concat("=", ""),
        expr: vals, // expr[0] is the RHS value
        init_expr: list_new(Expr),
        cond_expr: list_new(Expr),
        target_expr: targets,
        step_stmt: list_new(Stmt),
        then_block: list_new(Stmt),
        else_block: list_new(Stmt),
        body: list_new(Stmt),
        arm_variant: concat("", ""),
        arm_is_wildcard: false,
        arm_bind_vars: list_new(string),
        line: line,
        col: col,
    };
}

fn make_compound_assign_stmt(target: Expr, op: string, val: Expr, line: int, col: int) -> Stmt {
    let targets = list_new(Expr);
    targets = push(targets, target);
    let vals = list_new(Expr);
    vals = push(vals, val);
    return Stmt {
        kind: 3, // STMT_COMPOUND_ASSIGN
        var_name: concat("", ""),
        var_type: concat("", ""),
        has_explicit_type: false,
        op: concat(op, ""),
        expr: vals, // expr[0] is the RHS value
        init_expr: list_new(Expr),
        cond_expr: list_new(Expr),
        target_expr: targets,
        step_stmt: list_new(Stmt),
        then_block: list_new(Stmt),
        else_block: list_new(Stmt),
        body: list_new(Stmt),
        arm_variant: concat("", ""),
        arm_is_wildcard: false,
        arm_bind_vars: list_new(string),
        line: line,
        col: col,
    };
}

fn make_inc_dec_stmt(target: Expr, op: string, line: int, col: int) -> Stmt {
    let targets = list_new(Expr);
    targets = push(targets, target);
    return Stmt {
        kind: 4, // STMT_INC_DEC
        var_name: concat("", ""),
        var_type: concat("", ""),
        has_explicit_type: false,
        op: concat(op, ""),
        expr: list_new(Expr),
