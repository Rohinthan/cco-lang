}

fn make_method_call_expr(obj: Expr, method_name: string, args: Expr[], line: int, col: int) -> Expr {
    let ch = list_new(Expr);
    ch = push(ch, obj);
    return Expr {
        kind: 9, // EXPR_CALL
        int_val: 0,
        float_val: 0.0,
        str_val: concat("", ""),
        bool_val: false,
        char_val: ' ',
        op: concat("", ""),
        callee: concat(method_name, ""),
