        cond_expr: list_new(Expr),
        target_expr: targets,
        step_stmt: list_new(Stmt),
        then_block: list_new(Stmt),
        else_block: list_new(Stmt),
        body: list_new(Stmt),
        arm_variant: concat("", ""),
        arm_is_wildcard: false,
        arm_bind_vars: list_new(string),
        line: line,
        col: col,
    };
}

fn make_if_stmt(cond: Expr, then_b: Stmt[], else_b: Stmt[], line: int, col: int) -> Stmt {
    let conds = list_new(Expr);
    conds = push(conds, cond);
    return Stmt {
        kind: 5, // STMT_IF
        var_name: concat("", ""),
        var_type: concat("", ""),
        has_explicit_type: false,
        op: concat("", ""),
        expr: list_new(Expr),
        init_expr: list_new(Expr),
        cond_expr: conds,
        target_expr: list_new(Expr),
        step_stmt: list_new(Stmt),
        then_block: then_b,
        else_block: else_b,
        body: list_new(Stmt),
        arm_variant: concat("", ""),
        arm_is_wildcard: false,
        arm_bind_vars: list_new(string),
        line: line,
        col: col,
    };
}

fn make_while_stmt(cond: Expr, body: Stmt[], line: int, col: int) -> Stmt {
    let conds = list_new(Expr);
    conds = push(conds, cond);
    return Stmt {
        kind: 6, // STMT_WHILE
        var_name: concat("", ""),
        var_type: concat("", ""),
        has_explicit_type: false,
        op: concat("", ""),
        expr: list_new(Expr),
        init_expr: list_new(Expr),
        cond_expr: conds,
        target_expr: list_new(Expr),
        step_stmt: list_new(Stmt),
        then_block: list_new(Stmt),
        else_block: list_new(Stmt),
        body: body,
        arm_variant: concat("", ""),
        arm_is_wildcard: false,
        arm_bind_vars: list_new(string),
        line: line,
        col: col,
    };
}

fn make_for_stmt(init: Stmt, cond: Expr, step: Stmt, body: Stmt[], line: int, col: int) -> Stmt {
    let conds = list_new(Expr);
    conds = push(conds, cond);
    let inits = list_new(Stmt);
    inits = push(inits, init);
    let steps = list_new(Stmt);
    steps = push(steps, step);
    return Stmt {
        kind: 7, // STMT_FOR
        var_name: concat("", ""),
        var_type: concat("", ""),
        has_explicit_type: false,
        op: concat("", ""),
        expr: list_new(Expr),
        init_expr: list_new(Expr),
        cond_expr: conds,
        target_expr: list_new(Expr),
        step_stmt: steps,
        then_block: inits, // then_block[0] is the init stmt
        else_block: list_new(Stmt),
        body: body,
        arm_variant: concat("", ""),
        arm_is_wildcard: false,
        arm_bind_vars: list_new(string),
        line: line,
        col: col,
    };
}

fn make_return_stmt(exprs: Expr[], line: int, col: int) -> Stmt {
    return Stmt {
        kind: 8, // STMT_RETURN
        var_name: concat("", ""),
        var_type: concat("", ""),
        has_explicit_type: false,
        op: concat("", ""),
        expr: exprs,
        init_expr: list_new(Expr),
        cond_expr: list_new(Expr),
        target_expr: list_new(Expr),
        step_stmt: list_new(Stmt),
        then_block: list_new(Stmt),
        else_block: list_new(Stmt),
        body: list_new(Stmt),
        arm_variant: concat("", ""),
        arm_is_wildcard: false,
        arm_bind_vars: list_new(string),
        line: line,
        col: col,
    };
}

