fn make_block_stmt(stmts: Stmt[], line: int, col: int) -> Stmt {
    return Stmt {
        kind: 13, // STMT_BLOCK
        var_name: concat("", ""),
        var_type: concat("", ""),
        has_explicit_type: false,
        op: concat("", ""),
        expr: list_new(Expr),
        init_expr: list_new(Expr),
        cond_expr: list_new(Expr),
        target_expr: list_new(Expr),
        step_stmt: list_new(Stmt),
        then_block: list_new(Stmt),
        else_block: list_new(Stmt),
        body: stmts,
        arm_variant: concat("", ""),
        arm_is_wildcard: false,
        arm_bind_vars: list_new(string),
        line: line,
        col: col,
    };
}

fn make_match_stmt(expr: Expr, arms: Stmt[], line: int, col: int) -> Stmt {
    let exprs = list_new(Expr);
    exprs = push(exprs, expr);
    return Stmt {
        kind: 14, // STMT_MATCH
        var_name: concat("", ""),
        var_type: concat("", ""),
        has_explicit_type: false,
        op: concat("", ""),
        expr: exprs,
        init_expr: list_new(Expr),
        cond_expr: list_new(Expr),
        target_expr: list_new(Expr),
        step_stmt: list_new(Stmt),
        then_block: list_new(Stmt),
        else_block: list_new(Stmt),
        body: arms, // arms are Stmts of kind 15 (STMT_MATCH_ARM)
        arm_variant: concat("", ""),
        arm_is_wildcard: false,
        arm_bind_vars: list_new(string),
        line: line,
        col: col,
    };
}

fn make_match_arm(variant: string, is_wildcard: bool, bind_vars: string[], body: Stmt[], line: int, col: int) -> Stmt {
    return Stmt {
        kind: 15, // STMT_MATCH_ARM
        var_name: concat("", ""),
        var_type: concat("", ""),
        has_explicit_type: false,
        op: concat("", ""),
        expr: list_new(Expr),
        init_expr: list_new(Expr),
        cond_expr: list_new(Expr),
        target_expr: list_new(Expr),
        step_stmt: list_new(Stmt),
        then_block: list_new(Stmt),
        else_block: list_new(Stmt),
        body: body,
        arm_variant: concat(variant, ""),
        arm_is_wildcard: is_wildcard,
        arm_bind_vars: bind_vars,
        line: line,
        col: col,
    };
}

fn helper_arr_len_trigger(dummy: int[]) -> int {
    return len(dummy);
}
