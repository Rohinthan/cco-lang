// ast.cco - Abstract Syntax Tree Definitions for Self-Hosted Cco Compiler

class Param {
    name: string;
    type_name: string;
    is_borrowed: bool;
    is_array: bool;
}

class Field {
    name: string;
    type_name: string;
    is_array: bool;
}

class Expr {
    kind: int;
    int_val: int;
    float_val: float;
    str_val: string;
    bool_val: bool;
    char_val: char;
    op: string;
    callee: string;
    type_name: string;
    children: Expr[];
    args: Expr[];
    field_names: string[];
    field_values: Expr[];
    line: int;
    col: int;
}

class Stmt {
    kind: int;
    var_name: string;
    var_type: string;
    has_explicit_type: bool;
    op: string;
    expr: Expr[];
    init_expr: Expr[];
    cond_expr: Expr[];
    target_expr: Expr[];
    step_stmt: Stmt[];
    then_block: Stmt[];
    else_block: Stmt[];
    body: Stmt[];
    arm_variant: string;
    arm_is_wildcard: bool;
    arm_bind_vars: string[];
    line: int;
    col: int;
}

class FunctionDecl {
    name: string;
    params: Param[];
    return_type: string;
    is_operator: bool;
    operator_symbol: string;
    body: Stmt[];
    line: int;
    col: int;
}

class StructDecl {
    name: string;
    fields: Field[];
    line: int;
    col: int;
}

class ClassDecl {
    name: string;
    fields: Field[];
    methods: FunctionDecl[];
    line: int;
    col: int;
}

class VariantDecl {
    name: string;
    fields: Field[];
    is_unit: bool;
}

class EnumDecl {
    name: string;
    variants: VariantDecl[];
    line: int;
    col: int;
}

class Program {
    structs: StructDecl[];
    classes: ClassDecl[];
    enums: EnumDecl[];
    functions: FunctionDecl[];
}

// AST Helper Constructors

fn make_param(name: string, type_name: string, is_borrowed: bool, is_array: bool) -> Param {
    return Param {
        name: concat(name, ""),
        type_name: concat(type_name, ""),
        is_borrowed: is_borrowed,
        is_array: is_array,
    };
}

fn make_field(name: string, type_name: string, is_array: bool) -> Field {
    return Field {
        name: concat(name, ""),
        type_name: concat(type_name, ""),
        is_array: is_array,
    };
}

fn make_int_expr(val: int, line: int, col: int) -> Expr {
    return Expr {
        kind: 1, // EXPR_INT
        int_val: val,
        float_val: 0.0,
        str_val: concat("", ""),
        bool_val: false,
        char_val: ' ',
        op: concat("", ""),
        callee: concat("", ""),
        type_name: concat("int", ""),
        children: list_new(Expr),
        args: list_new(Expr),
        field_names: list_new(string),
        field_values: list_new(Expr),
        line: line,
        col: col,
    };
}

fn make_float_expr(val: float, line: int, col: int) -> Expr {
    return Expr {
        kind: 2, // EXPR_FLOAT
        int_val: 0,
        float_val: val,
        str_val: concat("", ""),
        bool_val: false,
        char_val: ' ',
        op: concat("", ""),
        callee: concat("", ""),
        type_name: concat("float", ""),
        children: list_new(Expr),
        args: list_new(Expr),
        field_names: list_new(string),
        field_values: list_new(Expr),
        line: line,
        col: col,
    };
}

fn make_string_expr(val: string, line: int, col: int) -> Expr {
    return Expr {
        kind: 3, // EXPR_STRING
        int_val: 0,
        float_val: 0.0,
        str_val: concat(val, ""),
        bool_val: false,
        char_val: ' ',
        op: concat("", ""),
        callee: concat("", ""),
        type_name: concat("string", ""),
        children: list_new(Expr),
        args: list_new(Expr),
        field_names: list_new(string),
        field_values: list_new(Expr),
        line: line,
        col: col,
    };
}

fn make_bool_expr(val: bool, line: int, col: int) -> Expr {
    return Expr {
        kind: 4, // EXPR_BOOL
        int_val: 0,
        float_val: 0.0,
        str_val: concat("", ""),
        bool_val: val,
        char_val: ' ',
        op: concat("", ""),
        callee: concat("", ""),
        type_name: concat("bool", ""),
        children: list_new(Expr),
        args: list_new(Expr),
        field_names: list_new(string),
        field_values: list_new(Expr),
        line: line,
        col: col,
    };
}

fn make_char_expr(val: char, line: int, col: int) -> Expr {
    return Expr {
        kind: 5, // EXPR_CHAR
        int_val: 0,
        float_val: 0.0,
        str_val: concat("", ""),
        bool_val: false,
        char_val: val,
        op: concat("", ""),
        callee: concat("", ""),
        type_name: concat("char", ""),
        children: list_new(Expr),
        args: list_new(Expr),
        field_names: list_new(string),
        field_values: list_new(Expr),
        line: line,
        col: col,
    };
}

fn make_ident_expr(name: string, line: int, col: int) -> Expr {
    return Expr {
        kind: 6, // EXPR_IDENT
        int_val: 0,
        float_val: 0.0,
        str_val: concat("", ""),
        bool_val: false,
        char_val: ' ',
        op: concat("", ""),
        callee: concat(name, ""),
        type_name: concat("", ""),
        children: list_new(Expr),
        args: list_new(Expr),
        field_names: list_new(string),
        field_values: list_new(Expr),
        line: line,
        col: col,
    };
}

fn make_binary_expr(op: string, left: Expr, right: Expr, line: int, col: int) -> Expr {
    let ch = list_new(Expr);
    ch = push(ch, left);
    ch = push(ch, right);
    return Expr {
        kind: 7, // EXPR_BINARY
        int_val: 0,
        float_val: 0.0,
        str_val: concat("", ""),
        bool_val: false,
        char_val: ' ',
        op: concat(op, ""),
        callee: concat("", ""),
        type_name: concat("", ""),
        children: ch,
        args: list_new(Expr),
        field_names: list_new(string),
        field_values: list_new(Expr),
        line: line,
        col: col,
    };
}

fn make_unary_expr(op: string, operand: Expr, line: int, col: int) -> Expr {
    let ch = list_new(Expr);
    ch = push(ch, operand);
    return Expr {
        kind: 8, // EXPR_UNARY
        int_val: 0,
        float_val: 0.0,
        str_val: concat("", ""),
        bool_val: false,
        char_val: ' ',
        op: concat(op, ""),
        callee: concat("", ""),
        type_name: concat("", ""),
        children: ch,
        args: list_new(Expr),
        field_names: list_new(string),
        field_values: list_new(Expr),
        line: line,
        col: col,
    };
}

fn make_call_expr(callee: string, args: Expr[], line: int, col: int) -> Expr {
    return Expr {
        kind: 9, // EXPR_CALL
        int_val: 0,
